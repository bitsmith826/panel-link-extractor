# ==========================================
# Telegram API Credentials
# Dapatkan dari https://my.telegram.org
# ==========================================
API_ID=12345678
API_HASH=your_api_hash_here

# Nama sesi penyimpanan login Telethon
SESSION_NAME=telegram_userbot

# (Opsional) Nomor HP akun Telegram (format internasional, cth: +628123456789)
# Jika dikosongkan, bot akan meminta input saat pertama kali dijalankan di terminal.
PHONE_NUMBER=

# ==========================================
# Filter & Target Listener
# ==========================================
# Target Chat / Channel / Group ID atau Username yang ingin dipantau.
# Pisahkan dengan koma. Contoh: -1001234567890,@namagrup,123456789
# KOSONGKAN jika ingin mendengarkan SEMUA grup/channel/chat yang diikuti oleh akun Anda.
TARGET_CHATS=

# Filter kata kunci pesan (case-insensitive).
# Hanya pesan yang mengandung salah satu kata kunci ini yang akan diproses.
# KOSONGKAN jika ingin mengekstrak link dari SEMUA pesan tanpa filter kata kunci.
# Contoh: panel,cpanel,admin,login,vps,ssh,token,key
FILTER_KEYWORDS=

# ==========================================
# Pengaturan Output Ekstraksi
# ==========================================
# Format penyimpanan: "json", "txt", atau "both"
OUTPUT_FORMAT=both

# Nama file keluaran
OUTPUT_FILE_JSON=extracted_links.json
OUTPUT_FILE_TXT=extracted_links.txt

# Simpan link duplikat atau abaikan? (true/false)
# Jika false: URL yang sudah pernah tersimpan sebelumnya tidak akan disimpan ulang.
ALLOW_DUPLICATES=false
